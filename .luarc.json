{
    "runtime": {
        "version": "LuaJIT",
        "builtin": {
            "utf8": "enable"
        },
        "special": {
            "love.filesystem.load": "loadfile",
            "modRequire": "require",
            "libRequire": "require"
        }
    },
    "workspace": {
        "library": [
            "${3rd}/love2d/library",
            "/home/aik/Projects/LuaProjects/kristal-lua-docs/library",
            ".helix/kristal-mod-globals.lua",
            "/home/aik/Projects/LuaProjects/Kristal/main.lua",
            "/home/aik/Projects/LuaProjects/Kristal/src"
        ],
        "checkThirdParty": "Disable",
        "ignoreDir": [
            ".helix",
            "assets"
        ]
    },
    "completion": {
        "autoRequire": false
    },
    "diagnostics": {
        "workspaceEvent": "OnChange",
        "globals": [
            "love"
        ],
        "disable": [
            "deprecated",
            "duplicate-set-field",
            "redundant-parameter",
            "undefined-doc-name",
            "return-type-mismatch",
            "lowercase-global",
            "need-check-nil",
            "cast-local-type",
            "inject-field",
            "undefined-field"
        ]
    },
    "type": {
        "weakNilCheck": true,
        "weakUnionCheck": true
    },
    "format": {
        "defaultConfig": {
            "indent_style": "space",
            "indent_size": "4"
        }
    }
}
