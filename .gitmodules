	branch = main
[submodule "libraries/kristal-i18n"]
	path = libraries/kristal-i18n
	url = https://github.com/Bli-AIk/kristal-i18n.git
	branch = main
[submodule ".emacs"]
	path = .emacs
	url = https://github.com/Bli-AIk/kristal-emacs-config.git
	branch = main
[submodule ".helix"]
	path = .helix
	url = https://github.com/Bli-AIk/kristal-helix-config.git
[submodule "libraries/terminal-cli"]
	path = libraries/terminal-cli
	url = https://github.com/Bli-AIk/kristal-terminal-cli.git
	branch = main
[submodule "libraries/kristal-debug-tools"]
	path = libraries/kristal-debug-tools
